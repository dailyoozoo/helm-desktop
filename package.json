{
  "name": "helm",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:tauri": "npm run build && vite preview --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.packages.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check:version": "node scripts/check-version.mjs",
    "pricing:validate": "node scripts/pricing-catalog.mjs --validate",
    "pricing:check-upstream": "node scripts/pricing-catalog.mjs --check-upstream",
    "pricing:sign": "tauri signer sign src-tauri/assets/pricing-catalog.json",
    "release:audit": "node scripts/change-27l-release-audit.mjs",
    "verify:27l": "node scripts/change-27l-release-audit.mjs --with-migrations",
    "verify": "npm run check && npm run check:version && npm run pricing:validate && cargo test --manifest-path src-tauri/Cargo.toml && npm run build && npm run release:audit",
    "visual:audit": "npm run build && node scripts/visual-audit.mjs",
    "probe": "tsx packages/probe/src/main.ts"
  },
  "dependencies": {
    "@helm/protocol": "*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.0"
  }
}
